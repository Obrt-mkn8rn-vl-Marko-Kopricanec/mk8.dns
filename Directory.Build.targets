<Project>
  <ItemGroup Condition="'$(OutputType)' != 'Exe' and '$(IsTestProject)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="xunit.analyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'mk8.dns.Domain' or '$(MSBuildProjectName)' == 'mk8.dns.Application.DAL' or '$(MSBuildProjectName)' == 'mk8.dns.Wire' or '$(MSBuildProjectName)' == 'mk8.dns.Engine.Authoritative' or '$(MSBuildProjectName)' == 'mk8.dns.Engine.Dnssec' or '$(MSBuildProjectName)' == 'mk8.dns.Presentation'">
    <PackageReference Include="NetFabric.Hyperlinq.Analyzer" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'mk8.dns.Engine.Recursive'">
    <PackageReference Include="NetFabric.Hyperlinq.Analyzer" PrivateAssets="all" />
  </ItemGroup>
  <!-- Active installation inputs are never build or publication content. The
       pinned package copies only its explicitly discovered portable templates. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'mk8.dns.Application' or '$(MSBuildProjectName)' == 'mk8.dns.Gateway' or '$(MSBuildProjectName)' == 'mk8.dns.Operator'">
    <Content Remove="Environment/**" />
    <None Remove="Environment/**" />
  </ItemGroup>
</Project>
